# Keep 126MB original CSV in its versioned GitHub Release (not normal Git).
# Track reviewed model and EDA report CSVs, plus the canonical split.
# Arbitrary local CSV files and secrets remain ignored.
*.csv
!reports/
!reports/*.csv
!data/
data/*
!data/split_ids.csv
!data/README.md
*.tsv
*.parquet
*.feather
*.arrow
*.zip
*.gz
*.7z
*.pkl
*.pickle
*.joblib
datasets/
.cache/
.kaggle/
# Python / notebooks
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.artifacts/
.output/
coverage/
.coverage
